{
  "manifest_version": 3,
  "name": "Torn Happy Jump Helper",
  "version": "2.5.0",
  "description": "Plans and tracks Torn happy jumps from your API data: Xanax stacking alerts, jump readiness, quarter-tick timer and gym gain estimates.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.torn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Happy Jump Helper"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.torn.com/gym.php*",
        "https://torn.com/gym.php*"
      ],
      "js": [
        "lib/log.js",
        "lib/calc.js",
        "lib/plan.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}